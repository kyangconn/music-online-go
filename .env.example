# ============================================================
# Music Online - Docker Compose environment template
#
# 这份文件只负责 Docker Compose 层面的参数（端口、卷、镜像、路径），
# 不负责应用本身的业务配置。应用配置在 config*.yaml 里。
#
# 最简单的用法：
#   1. cp .env.example .env
#   2. 把 JWT_SECRET 改成随机值：openssl rand -hex 32
#   3. make docker-up
#
# 注意：compose.yaml 默认不发布宿主机端口，适合 Traefik/反代；
# make docker-up 会自动叠加 compose.ports.yaml 来发布端口。
#
# 非 Docker 部署不需要这份文件，直接看 config-example.yaml。
# ============================================================

# ---------- 必填 ----------
# 登录令牌签名密钥，至少 32 字节。生成：openssl rand -hex 32
JWT_SECRET=

# ---------- 宿主机访问端口 ----------
# 宿主机监听地址。127.0.0.1 = 仅本机可访问；0.0.0.0 = 对外开放（建议配合防火墙/反代）
APP_BIND_ADDRESS=127.0.0.1
# 宿主机对外端口，也就是你浏览器里访问的端口
APP_PORT=8080
# 容器内部监听端口，通常保持 8080 即可
APP_CONTAINER_PORT=8080

# ---------- 配置文件挂载 ----------
# 宿主机上的应用配置文件（会被只读挂载进容器）
CONFIG_FILE=./config-docker-example.yaml
# 该文件在容器内的路径；一般不需要改
MO_CONFIG_FILE=/etc/music-online/config.yaml

# ---------- 数据卷 ----------
# SQLite 数据库和上传文件存放在这个 Docker 命名卷里
DATA_PATH=music-online-data
DATA_VOLUME_NAME=music-online-data

# ---------- 可选：挂载本机音乐目录 ----------
# 取消注释并填写真实路径后，使用 make docker-up-media 启动
# MEDIA_PATH=/srv/music
# MEDIA_CONTAINER_PATH=/media/music
# MEDIA_BIND_PROPAGATION=rprivate

# ---------- Compose 基础行为（一般默认即可） ----------
COMPOSE_PROJECT_NAME=music-online
MUSIC_ONLINE_IMAGE=music-online-go:local
RESTART_POLICY=unless-stopped
READ_ONLY_ROOTFS=true
LOG_DRIVER=local
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
TMPFS_SIZE=256m
STOP_GRACE_PERIOD=30s
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_START_PERIOD=15s
HEALTHCHECK_RETRIES=3

# ---------- 镜像版本元数据（CI 或手动构建时使用） ----------
VERSION=dev
VCS_REF=unknown
BUILD_DATE=1970-01-01T00:00:00Z

# ---------- 可选：HTTP analyzer ----------
# 需要额外 analyzer 镜像时才启用，普通部署不用管
# ANALYZER_IMAGE=registry.example.com/music-analyzer:version
# ANALYZER_ID=implementation-id
# ANALYZER_VERSION=1.0.0
# ANALYZER_MODEL_VERSION=model-v1
# ANALYZER_TOKEN=
# ANALYZER_TOKEN_HOST_FILE=./secrets/analyzer_token
# ANALYZER_PORT=8090
# ANALYZER_TIMEOUT_SECONDS=300
# ANALYZER_CONCURRENCY=1
# ANALYZER_QUEUE_LIMIT=1000
# ANALYZER_MAX_FILE_SIZE_MB=2048
# ANALYZER_MAX_DURATION_SECONDS=1800
# ANALYZER_RETRY_MAX_ATTEMPTS=3
# ANALYZER_RETRY_INITIAL_SECONDS=30
# ANALYZER_RETRY_MAX_SECONDS=900
# ANALYZER_RESTART_POLICY=unless-stopped
# ANALYZER_CPUS=2.0
# ANALYZER_MEMORY_LIMIT=2g
# ANALYZER_PIDS_LIMIT=256
# ANALYZER_TMPFS_SIZE=512m
# ANALYZER_STOP_GRACE_PERIOD=30s

# ---------- 可选：PostgreSQL（会额外启动一个 Postgres 容器） ----------
# 如果你已经有 PostgreSQL，不要用 compose.postgres.yaml，
# 而是直接在应用配置里指向已有数据库。
# POSTGRES_IMAGE=postgres:18-alpine3.23
# POSTGRES_USER=music_online
# POSTGRES_PASSWORD=
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# POSTGRES_DB=music_online
# POSTGRES_PORT=5432
# POSTGRES_DATA_PATH=music-online-postgres-data
# POSTGRES_DATA_VOLUME_NAME=music-online-postgres-data
# POSTGRES_STOP_GRACE_PERIOD=30s
# POSTGRES_HEALTHCHECK_INTERVAL=10s
# POSTGRES_HEALTHCHECK_TIMEOUT=5s
# POSTGRES_HEALTHCHECK_START_PERIOD=10s
# POSTGRES_HEALTHCHECK_RETRIES=5

# ---------- 可选：Compose secrets ----------
# 用文件代替环境变量传密钥时使用
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# JWT_SECRET_HOST_FILE=./secrets/jwt_secret
# MUSICBEE_SUBMIT_TOKEN_HOST_FILE=./secrets/musicbee_submit_token
# POSTGRES_PASSWORD_HOST_FILE=./secrets/postgres_password

